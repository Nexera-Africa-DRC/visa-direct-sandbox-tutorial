# ─── Visa Developer sandbox credentials ─────────────────────────────
# Get these from https://developer.visa.com/portal → your project → Credentials
#
# These values are secrets. Never commit them. Copy this file to `.env` and
# fill in your real values locally.

# Base URL — always sandbox.api.visa.com unless you have production approval
VISA_BASE_URL=https://sandbox.api.visa.com

# ─── Basic Auth (Credentials → Two-Way SSL → Inbound) ───────────────
# Each cert you generate on the dashboard comes with its own User ID /
# Password pair. If you rotate the cert, these change too — remember to
# re-sync this .env file.
VISA_USER_ID=
VISA_PASSWORD=

# ─── X-Pay Token credentials (Credentials → X-Pay Token → Inbound) ──
# Not strictly needed for Visa Direct push funds (we use Basic Auth there),
# but kept here for completeness. API_KEY is the "Shared Key ID", and
# SHARED_SECRET is RSA-OAEP-encrypted by Visa — you need your own RSA key
# pair to decrypt it. See docs/01-setup-visa-developer-account.md.
VISA_API_KEY=
VISA_SHARED_SECRET=

# ─── mTLS certificates ──────────────────────────────────────────────
# cert.pem + key.pem = client cert pair from Credentials → Two-Way SSL
# ca-cert.pem = CA bundle for verifying Visa's server cert (we recommend
# `cp $(python -c "import certifi; print(certifi.where())") ca-cert.pem`
# because the DigiCert-only cert Visa provides is incomplete).
VISA_CERT_PATH=./certs/cert.pem
VISA_KEY_PATH=./certs/key.pem
VISA_CA_CERT_PATH=./certs/ca-cert.pem

# ─── MLE (Message Level Encryption) — MANDATORY ─────────────────────
# Get these from Credentials → Message Level Encryption → generate Key ID.
# You'll download 3 files:
#   - mle_private.pem      : our private key (decrypt their responses)
#   - mle_client_cert.pem  : our public cert (not actually used in requests,
#                            but keep it — it ties your private key to the Key ID)
#   - mle_server_cert.pem  : Visa server public key (encrypt our requests)
VISA_MLE_KEY_ID=
VISA_MLE_SERVER_CERT_PATH=./certs/mle/mle_server_cert.pem
VISA_MLE_PRIVATE_KEY_PATH=./certs/mle/mle_private.pem
